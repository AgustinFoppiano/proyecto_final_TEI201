  "function calcularProximaFecha(\n"
  "  hora,\n"
  "  minuto,\n"
  "  repeticion,\n"
  "  dias,\n"
  "  fechaTexto\n"
  ") {\n"
  "\n"
  "  const ahora =\n"
  "    new Date();\n"
  "\n"
  "\n"
  "  if (\n"
  "    repeticion === 0 ||\n"
  "    repeticion === 1\n"
  "  ) {\n"
  "\n"
  "    const fecha =\n"
  "      new Date(\n"
  "        ahora.getFullYear(),\n"
  "        ahora.getMonth(),\n"
  "        ahora.getDate(),\n"
  "        hora,\n"
  "        minuto,\n"
  "        0,\n"
  "        0\n"
  "      );\n"
  "\n"
  "\n"
  "    if (\n"
  "      fecha <= ahora\n"
  "    ) {\n"
  "\n"
  "      fecha.setDate(\n"
  "        fecha.getDate() + 1\n"
  "      );\n"
  "    }\n"
  "\n"
  "\n"
  "    return fecha;\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    repeticion === 2\n"
  "  ) {\n"
  "\n"
  "    for (\n"
  "      let i = 0;\n"
  "      i <= 7;\n"
  "      i++\n"
  "    ) {\n"
  "\n"
  "      const fecha =\n"
  "        new Date(\n"
  "          ahora.getFullYear(),\n"
  "          ahora.getMonth(),\n"
  "          ahora.getDate() + i,\n"
  "          hora,\n"
  "          minuto,\n"
  "          0,\n"
  "          0\n"
  "        );\n"
  "\n"
  "\n"
  "      const diaSemana =\n"
  "        fecha.getDay();\n"
  "\n"
  "\n"
  "      const elegido =\n"
  "\n"
  "        (\n"
  "          dias &\n"
  "          (\n"
  "            1 << diaSemana\n"
  "          )\n"
  "        ) !== 0;\n"
  "\n"
  "\n"
  "      if (\n"
  "        elegido &&\n"
  "        fecha > ahora\n"
  "      ) {\n"
  "\n"
  "        return fecha;\n"
  "      }\n"
  "    }\n"
  "\n"
  "\n"
  "    return null;\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    repeticion === 3\n"
  "  ) {\n"
  "\n"
  "    if (\n"
  "      !fechaTexto\n"
  "    ) {\n"
  "\n"
  "      return null;\n"
  "    }\n"
  "\n"
  "\n"
  "    const partes =\n"
  "      fechaTexto.split(\n"
  "        \"-\"\n"
  "      );\n"
  "\n"
  "\n"
  "    const fecha =\n"
  "      new Date(\n"
  "\n"
  "        Number(\n"
  "          partes[0]\n"
  "        ),\n"
  "\n"
  "        Number(\n"
  "          partes[1]\n"
  "        ) - 1,\n"
  "\n"
  "        Number(\n"
  "          partes[2]\n"
  "        ),\n"
  "\n"
  "        hora,\n"
  "\n"
  "        minuto,\n"
  "\n"
  "        0,\n"
  "\n"
  "        0\n"
  "      );\n"
  "\n"
  "\n"
  "    if (\n"
  "      fecha <= ahora\n"
  "    ) {\n"
  "\n"
  "      return null;\n"
  "    }\n"
  "\n"
  "\n"
  "    return fecha;\n"
  "  }\n"
  "\n"
  "\n"
  "  return null;\n"
  "}\n"
  "\n"
  "\n"
  "function calcularTiempoRestante(\n"
  "  fecha\n"
  ") {\n"
  "\n"
  "  const ahora =\n"
  "    new Date();\n"
  "\n"
  "\n"
  "  const diferencia =\n"
  "    fecha -\n"
  "    ahora;\n"
  "\n"
  "\n"
  "  const minutosTotales =\n"
  "    Math.max(\n"
  "      1,\n"
  "      Math.ceil(\n"
  "        diferencia /\n"
  "        60000\n"
  "      )\n"
  "    );\n"
  "\n"
  "\n"
  "  const dias =\n"
  "    Math.floor(\n"
  "      minutosTotales /\n"
  "      1440\n"
  "    );\n"
  "\n"
  "\n"
  "  const resto =\n"
  "    minutosTotales %\n"
  "    1440;\n"
  "\n"
  "\n"
  "  const horas =\n"
  "    Math.floor(\n"
  "      resto /\n"
  "      60\n"
  "    );\n"
  "\n"
  "\n"
  "  const minutos =\n"
  "    resto %\n"
  "    60;\n"
  "\n"
  "\n"
  "  let texto = \"\";\n"
  "\n"
  "\n"
  "  if (\n"
  "    dias > 0\n"
  "  ) {\n"
  "\n"
  "    texto +=\n"
  "\n"
  "      dias +\n"
  "\n"
  "      (\n"
  "        dias === 1\n"
  "          ? \" día\"\n"
  "          : \" días\"\n"
  "      );\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    dias > 0 &&\n"
  "    horas > 0\n"
  "  ) {\n"
  "\n"
  "    texto +=\n"
  "      \" y \";\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    horas > 0\n"
  "  ) {\n"
  "\n"
  "    texto +=\n"
  "\n"
  "      horas +\n"
  "\n"
  "      (\n"
  "        horas === 1\n"
  "          ? \" hora\"\n"
  "          : \" horas\"\n"
  "      );\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    (dias > 0 || horas > 0) &&\n"
  "    minutos > 0\n"
  "  ) {\n"
  "\n"
  "    texto +=\n"
  "      \" y \";\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    minutos > 0\n"
  "  ) {\n"
  "\n"
  "    texto +=\n"
  "\n"
  "      minutos +\n"
  "\n"
  "      (\n"
  "        minutos === 1\n"
  "          ? \" minuto\"\n"
  "          : \" minutos\"\n"
  "      );\n"
  "  }\n"
  "\n"
  "\n"
  "  return texto;\n"
  "}\n"
  "\n"
  "\n"
  "function descripcionRepeticion(\n"
  "  alarma\n"
  ") {\n"
  "\n"
  "  if (\n"
  "    alarma.repeat === 0\n"
  "  ) {\n"
  "\n"
  "    return (\n"
  "\n"
  "      \"Una vez · \" +\n"
  "\n"
  "      dos(\n"
  "        alarma.day\n"
  "      ) +\n"
  "\n"
  "      \"/\" +\n"
  "\n"
  "      dos(\n"
  "        alarma.month\n"
  "      ) +\n"
  "\n"
  "      \"/\" +\n"
  "\n"
  "      alarma.year\n"
  "    );\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    alarma.repeat === 1\n"
  "  ) {\n"
  "\n"
  "    return \"Todos los días\";\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    alarma.repeat === 2\n"
  "  ) {\n"
  "\n"
  "    const dias = [];\n"
  "\n"
  "\n"
  "    for (\n"
  "      let i = 1;\n"
  "      i <= 6;\n"
  "      i++\n"
  "    ) {\n"
  "\n"
  "      if (\n"
  "        alarma.days &\n"
  "        (\n"
  "          1 << i\n"
  "        )\n"
  "      ) {\n"
  "\n"
  "        dias.push(\n"
  "          nombresDias[i]\n"
  "        );\n"
  "      }\n"
  "    }\n"
  "\n"
  "\n"
  "    if (\n"
  "      alarma.days &\n"
  "      1\n"
  "    ) {\n"
  "\n"
  "      dias.push(\n"
  "        \"Dom\"\n"
  "      );\n"
  "    }\n"
  "\n"
  "\n"
  "    return dias.join(\n"
  "      \", \"\n"
  "    );\n"
  "  }\n"
  "\n"
  "\n"
  "  if (\n"
  "    alarma.repeat === 3\n"
  "  ) {\n"
  "\n"
  "    return (\n"
  "\n"
  "      \"Fecha: \" +\n"
  "\n"
  "      dos(\n"
  "        alarma.day\n"
  "      ) +\n"
  "\n"
  "      \"/\" +\n"
  "\n"
  "      dos(\n"
  "        alarma.month\n"
  "      ) +\n"
  "\n"
  "      \"/\" +\n"
  "\n"
  "      alarma.year\n"
  "    );\n"
  "  }\n"
  "\n"
  "\n"
  "  return \"\";\n"
  "}\n"
