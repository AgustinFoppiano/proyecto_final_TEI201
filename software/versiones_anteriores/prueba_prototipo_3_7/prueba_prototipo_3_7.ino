const uint8_t cantidadCuadrosOLED = sizeof(cuadrosVideoOLED) / sizeof(cuadrosVideoOLED[0]);
const unsigned long intervaloVideoOLED = 80UL;

bool detectarPantallaOLED() {
  const uint8_t direcciones[] = {0x3C, 0x3D};
  for (uint8_t i = 0; i < 2; ++i) {
    Wire.beginTransmission(direcciones[i]);
    if (Wire.endTransmission() == 0) {
      // U8g2 espera la direccion I2C de 8 bits.
      pantallaPrueba.setI2CAddress(direcciones[i] << 1);
      pantallaPrueba.begin();
      pantallaPrueba.setBusClock(400000);
      Serial.print("Pantalla OLED detectada en 0x");
      Serial.println(direcciones[i], HEX);
      return true;
    }
  }
  Serial.println("OLED no detectada: revisar cables y contacto de patitas.");
  return false;
}

void iniciarPruebaOLED() {
  Wire.begin(21, 22);
  Wire.setTimeOut(20);
  pantallaPruebaDetectada = detectarPantallaOLED();
  ultimoIntentoOLED = millis();
}

void actualizarPruebaOLED() {
  // Mantener la prioridad de la alarma, igual que en la version anterior.
  if (musicaActiva) return;

  unsigned long ahoraOLED = millis();
  if (!pantallaPruebaDetectada) {
    if ((unsigned long)(ahoraOLED - ultimoIntentoOLED) >= 3000UL) {
      ultimoIntentoOLED = ahoraOLED;
      pantallaPruebaDetectada = detectarPantallaOLED();
    }
    return;
  }
  if ((unsigned long)(ahoraOLED - ultimoCuadroOLED) < intervaloVideoOLED) return;
  ultimoCuadroOLED = ahoraOLED;

  pantallaPrueba.firstPage();
  do {
    pantallaPrueba.drawXBMP(0, 0, 128, 64, cuadrosVideoOLED[cuadroOLED]);
  } while (pantallaPrueba.nextPage());

  cuadroOLED = (cuadroOLED + 1) % cantidadCuadrosOLED;
}

// =====================================================
// SETUP
// =====================================================

void setup() {

  Serial.begin(
    115200
  );


  // Buzzer:
  // + -> D18
  // - -> GND

  ledcAttach(
    BUZZER,
    2000,
    8
  );


  ledcWriteTone(
    BUZZER,
    0
  );


  // Motor vibrador:
  // IN  -> D15
  // VCC -> alimentacion usada en el montaje que ya funciono
  // GND -> GND
  //
  // Empieza apagado para evitar vibracion accidental al arrancar.

  pinMode(
    MOTOR_VIBRACION,
    OUTPUT
  );


  digitalWrite(
    MOTOR_VIBRACION,
    LOW
  );


  cargarAlarmasDeMemoria();


  crearRedWifi();


  dnsServer.setTTL(
    3600
  );


  dnsServer.start(
    53,
    "*",
    ipLocal
  );


  configurarServidor();


  server.begin();

  iniciarPruebaOLED();

  Serial.println();

  Serial.println(
    "ALARMA INICIADA"
  );


  Serial.println(
    "BUZZER D18"
  );


  Serial.println(
    "MOTOR D15"
  );
}

// =====================================================
// LOOP
// =====================================================

void loop() {

  dnsServer.processNextRequest();


  comprobarAlarmas();


  actualizarMusica();

  actualizarPruebaOLED();

  delay(
    5
  );
}