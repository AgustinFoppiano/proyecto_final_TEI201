// =====================================================
// SERVIDOR
// =====================================================

void configurarServidor() {

  // HORA

  server.on(

    "/api/sync-time",

    HTTP_POST,

    [](AsyncWebServerRequest* request) {

      if (

        !request->hasParam(
          "epoch"
        )

        ||

        !request->hasParam(
          "offset"
        )

      ) {

        request->send(
          400,
          "text/plain",
          "Error"
        );

        return;
      }


      int64_t epochMs =

        strtoll(

          request
          ->getParam(
            "epoch"
          )
          ->value()
          .c_str(),

          nullptr,

          10
        );


      int offsetMinutos =

        request
        ->getParam(
          "offset"
        )
        ->value()
        .toInt();


      horaLocalSincronizada =

        (
          epochMs /
          1000
        )

        -

        (
          (int64_t)
          offsetMinutos *
          60
        );


      millisSincronizacion =
        millis();


      horaSincronizada =
        true;


      request->send(
        200,
        "text/plain",
        "OK"
      );
    }
  );


  // LISTA

  server.on(

    "/api/alarms",

    HTTP_GET,

    [](AsyncWebServerRequest* request) {

      AsyncWebServerResponse*
        respuesta =

          request->beginResponse(

            200,

            "application/json",

            crearJsonAlarmas()
          );


      respuesta->addHeader(
        "Cache-Control",
        "no-store"
      );


      request->send(
        respuesta
      );
    }
  );


  // GUARDAR

  server.on(

    "/api/save",

    HTTP_POST,

    [](AsyncWebServerRequest* request) {

      const char* parametros[] = {

        "index",
        "hour",
        "minute",
        "tone",
        "mode",
        "repeat",
        "days",
        "year",
        "month",
        "day",
        "active"
      };


      for (
        int i = 0;
        i < 11;
        i++
      ) {

        if (
          !request->hasParam(
            parametros[i]
          )
        ) {

          request->send(
            400,
            "text/plain",
            "Faltan datos"
          );

          return;
        }
      }


      int indice =
        request->getParam(
          "index"
        )->value().toInt();


      int hora =
        request->getParam(
          "hour"
        )->value().toInt();


      int minuto =
        request->getParam(
          "minute"
        )->value().toInt();


      int tono =
        request->getParam(
          "tone"
        )->value().toInt();


      int modo =
        request->getParam(
          "mode"
        )->value().toInt();


      int repeticion =
        request->getParam(
          "repeat"
        )->value().toInt();


      int dias =
        request->getParam(
          "days"
        )->value().toInt();


      int anio =
        request->getParam(
          "year"
        )->value().toInt();


      int mes =
        request->getParam(
          "month"
        )->value().toInt();


      int dia =
        request->getParam(
          "day"
        )->value().toInt();


      bool activa =

        request->getParam(
          "active"
        )->value().toInt()

        == 1;


      if (
        indice == -1
      ) {

        if (
          cantidadAlarmas >=
          MAX_ALARMAS
        ) {

          request->send(
            400,
            "text/plain",
            "Máximo 10 alarmas"
          );

          return;
        }


        indice =
          cantidadAlarmas;


        cantidadAlarmas++;
      }

      else if (

        indice < 0 ||

        indice >=
        cantidadAlarmas

      ) {

        request->send(
          400,
          "text/plain",
          "Índice inválido"
        );

        return;
      }


      if (
        alarmaSonandoIndice ==
        indice
      ) {

        detenerAlarmaActual();
      }


      alarmas[indice].hora =
        hora;


      alarmas[indice].minuto =
        minuto;


      alarmas[indice].tono =
        tono;


      alarmas[indice].modo =
        modo;


      alarmas[indice].repeticion =
        repeticion;


      alarmas[indice].diasSemana =
        dias;


      alarmas[indice].anio =
        anio;


      alarmas[indice].mes =
        mes;


      alarmas[indice].dia =
        dia;


      alarmas[indice].activa =
        activa;


      ultimoDiaActivado[
        indice
      ] =
        -1;


      guardarAlarmasEnMemoria();


      request->send(
        200,
        "text/plain",
        "OK"
      );
    }
  );


  // ACTIVAR / DESACTIVAR

  server.on(

    "/api/toggle",

    HTTP_POST,

    [](AsyncWebServerRequest* request) {

      if (

        !request->hasParam(
          "index"
        )

        ||

        !request->hasParam(
          "active"
        )

      ) {

        request->send(
          400,
          "text/plain",
          "Error"
        );

        return;
      }


      int indice =

        request
        ->getParam(
          "index"
        )
        ->value()
        .toInt();


      bool activa =

        request
        ->getParam(
          "active"
        )
        ->value()
        .toInt()

        == 1;


      if (

        indice < 0 ||

        indice >=
        cantidadAlarmas

      ) {

        request->send(
          400,
          "text/plain",
          "Índice inválido"
        );

        return;
      }


      alarmas[indice].activa =
        activa;


      if (
        activa
      ) {

        ultimoDiaActivado[
          indice
        ] =
          -1;


        reprogramarUnaVez(
          indice
        );
      }


      if (

        !activa &&

        alarmaSonandoIndice ==
        indice

      ) {

        detenerAlarmaActual();
      }


      guardarAlarmasEnMemoria();


      request->send(
        200,
        "text/plain",
        "OK"
      );
    }
  );


  // ELIMINAR

  server.on(

    "/api/delete",

    HTTP_POST,

    [](AsyncWebServerRequest* request) {

      if (
        !request->hasParam(
          "index"
        )
      ) {

        request->send(
          400,
          "text/plain",
          "Error"
        );

        return;
      }


      int indice =

        request
        ->getParam(
          "index"
        )
        ->value()
        .toInt();


      if (

        indice < 0 ||

        indice >=
        cantidadAlarmas

      ) {

        request->send(
          400,
          "text/plain",
          "Índice inválido"
        );

        return;
      }


      if (
        alarmaSonandoIndice ==
        indice
      ) {

        detenerAlarmaActual();
      }

      else if (

        alarmaSonandoIndice >
        indice

      ) {

        alarmaSonandoIndice--;
      }


      for (

        int i = indice;

        i <
        cantidadAlarmas - 1;

        i++

      ) {

        alarmas[i] =
          alarmas[
            i + 1
          ];


        ultimoDiaActivado[i] =
          ultimoDiaActivado[
            i + 1
          ];
      }


      cantidadAlarmas--;


      guardarAlarmasEnMemoria();


      request->send(
        200,
        "text/plain",
        "OK"
      );
    }
  );


  // DETENER

  server.on(

    "/api/stop",

    HTTP_POST,

    [](AsyncWebServerRequest* request) {

      detenerAlarmaActual();


      request->send(
        200,
        "text/plain",
        "OK"
      );
    }
  );


  // ESTADO

  server.on(

    "/api/status",

    HTTP_GET,

    [](AsyncWebServerRequest* request) {

      String json =
        "{";


      json +=
        "\"synced\":";


      json +=

        horaSincronizada

          ? "true"

          : "false";


      if (
        horaSincronizada
      ) {

        int64_t ahora =
          obtenerHoraLocal();


        int segundosDia =
          ahora %
          86400;


        if (
          segundosDia < 0
        ) {

          segundosDia +=
            86400;
        }


        int hora =
          segundosDia /
          3600;


        int minuto =

          (
            segundosDia %
            3600
          )
          /
          60;


        int segundo =
          segundosDia %
          60;


        json +=
          ",\"hour\":";

        json +=
          hora;


        json +=
          ",\"minute\":";

        json +=
          minuto;


        json +=
          ",\"second\":";

        json +=
          segundo;
      }


      json +=
        ",\"ringing\":";


      json +=

        alarmaSonandoIndice >= 0

          ? "true"

          : "false";


      json +=
        ",\"event\":\"";


      json +=
        ultimoEvento;


      json +=
        "\"";


      json +=
        "}";


      AsyncWebServerResponse*
        respuesta =

          request->beginResponse(

            200,

            "application/json",

            json
          );


      respuesta->addHeader(
        "Cache-Control",
        "no-store"
      );


      request->send(
        respuesta
      );
    }
  );


  // =================================================
  // PORTAL CAUTIVO
  // =================================================

  server.on(
    "/generate_204",
    HTTP_ANY,

    [](AsyncWebServerRequest* request) {

      request->redirect(
        direccionPortal.c_str()
      );
    }
  );


  server.on(
    "/gen_204",
    HTTP_ANY,

    [](AsyncWebServerRequest* request) {

      request->redirect(
        direccionPortal.c_str()
      );
    }
  );


  server.on(
    "/hotspot-detect.html",
    HTTP_ANY,

    [](AsyncWebServerRequest* request) {

      request->redirect(
        direccionPortal.c_str()
      );
    }
  );


  server.on(
    "/connecttest.txt",
    HTTP_ANY,

    [](AsyncWebServerRequest* request) {

      request->redirect(
        "http://logout.net"
      );
    }
  );


  server.on(
    "/ncsi.txt",
    HTTP_ANY,

    [](AsyncWebServerRequest* request) {

      request->redirect(
        direccionPortal.c_str()
      );
    }
  );


  server.on(
