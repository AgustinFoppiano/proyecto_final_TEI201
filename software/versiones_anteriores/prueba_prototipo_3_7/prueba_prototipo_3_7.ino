int cantidadNotasTono(
  uint8_t tono
) {

  switch (tono) {

    case 0:
      return homecomingCantidad;

    case 1:
      return quantumCantidad;

    case 2:
      return spaceCantidad;

    case 3:
      return megalovaniaCantidad;

    case 4:
      return neverGonnaCantidad;

    case 5:
      return takeOnMeCantidad;
  }


  return 0;
}


int frecuenciaTono(
  uint8_t tono,
  int indice
) {

  switch (tono) {

    case 0:
      return homecomingNotas[
        indice
      ];

    case 1:
      return quantumNotas[
        indice
      ];

    case 2:
      return spaceNotas[
        indice
      ];

    case 3:
      return megalovaniaNotas[
        indice
      ];

    case 4:
      return neverGonnaNotas[
        indice
      ];

    case 5:
      return takeOnMeNotas[
        indice
      ];
  }


  return 0;
}


int duracionTono(
  uint8_t tono,
  int indice
) {

  switch (tono) {

    case 0:
      return homecomingDuraciones[
        indice
      ];

    case 1:
      return quantumDuraciones[
        indice
      ];

    case 2:
      return spaceDuraciones[
        indice
      ];

    case 3:
      return megalovaniaDuraciones[
        indice
      ];

    case 4:
      return neverGonnaDuraciones[
        indice
      ];

    case 5:
      return takeOnMeDuraciones[
        indice
      ];
  }


  return 200;
}

// =====================================================
// SALIDAS: SONIDO + VIBRACION
//
// modo:
// 0 = solo sonido
// 1 = solo vibracion
// 2 = sonido + vibracion
//
// El motor no produce notas musicales.
// Para representar la melodia, vibra durante cada nota
// y se apaga durante las pausas, usando exactamente
// las mismas duraciones que la cancion.
// =====================================================

void apagarSalidas() {

  ledcWriteTone(
    BUZZER,
    0
  );

  digitalWrite(
    MOTOR_VIBRACION,
    LOW
  );
}


void reproducirNotaActual(
  uint8_t tono,
  int indice,
  uint8_t modo
) {

  int frecuencia =
    frecuenciaTono(
      tono,
      indice
    );


  // -----------------------------
  // BUZZER
  // -----------------------------

  if (
    modo != 1 &&
    frecuencia > 0
  ) {

    ledcWriteTone(
      BUZZER,
      frecuencia
    );
  }

  else {

    ledcWriteTone(
      BUZZER,
      0
    );
  }


  // -----------------------------
  // MOTOR
  // -----------------------------
  //
  // HIGH = vibracion fuerte.
  // Si la melodia contiene una pausa real (frecuencia 0),
  // el motor tambien queda apagado durante esa pausa.

  if (
    modo != 0 &&
    frecuencia > 0
  ) {

    digitalWrite(
      MOTOR_VIBRACION,
      HIGH
    );
  }

  else {

    digitalWrite(
      MOTOR_VIBRACION,
      LOW
    );
  }
}


// =====================================================
// DETENER
// =====================================================

void detenerAlarmaActual() {

  musicaActiva =
    false;


  apagarSalidas();


  if (
    alarmaSonandoIndice >= 0
  ) {

    ultimoEvento =
      "Alarma detenida";
  }


  alarmaSonandoIndice =
    -1;


  notaActual =
    0;


  pausaEntreNotas =
    false;
}

// =====================================================
// INICIAR ALARMA
// =====================================================

void iniciarAlarma(
  int indice
) {

  if (
    indice < 0 ||
    indice >= cantidadAlarmas
  ) {

    return;
  }


  alarmaSonandoIndice =
    indice;


  ultimoEvento =

    "Alarma activada: " +

    nombreTono(
      alarmas[indice].tono
    )

    + " - " +

    nombreModo(
      alarmas[indice].modo
    );


  Serial.println(
    ultimoEvento
  );


  musicaActiva =
    true;


  notaActual =
    0;


  pausaEntreNotas =
    false;


  uint8_t tono =
    alarmas[indice].tono;


  reproducirNotaActual(

    tono,

    notaActual,

    alarmas[indice].modo

  );


  siguienteCambioMusica =

    millis() +

    duracionTono(
      tono,
      notaActual
    );
}

// =====================================================
// ACTUALIZAR MUSICA
// =====================================================

void actualizarMusica() {

  if (
    !musicaActiva ||
    alarmaSonandoIndice < 0
  ) {

    return;
  }


  if (
    alarmaSonandoIndice >=
    cantidadAlarmas
  ) {

    detenerAlarmaActual();

    return;
  }


  unsigned long ahora =
    millis();


  if (

    (long)(
      ahora -
      siguienteCambioMusica
    )

    < 0

  ) {

    return;
  }


  uint8_t tono =

    alarmas[
      alarmaSonandoIndice
    ].tono;


  if (
    !pausaEntreNotas
  ) {

    apagarSalidas();


    pausaEntreNotas =
      true;


    siguienteCambioMusica =
      ahora +
      40;
  }

  else {

    notaActual++;


    int cantidad =
      cantidadNotasTono(
        tono
      );


    // Al llegar al final,
    // vuelve al inicio de la parte reconocible.

    if (
      notaActual >=
      cantidad
    ) {

      notaActual =
        0;
    }


    reproducirNotaActual(

      tono,

      notaActual,

      alarmas[
        alarmaSonandoIndice
      ].modo

    );


    pausaEntreNotas =
      false;


    siguienteCambioMusica =

      ahora +

      duracionTono(
        tono,
        notaActual
      );
  }
}

// =====================================================
// FECHA
// =====================================================

bool correspondeFecha(
  const Alarma& alarma,
  int anio,
  unsigned mes,
  unsigned dia,
  int diaSemana
) {

  if (
    alarma.repeticion ==
    0
  ) {

    return

      alarma.anio ==
      anio

      &&

      alarma.mes ==
      mes

      &&

      alarma.dia ==
      dia;
  }


  if (
    alarma.repeticion ==
    1
  ) {

    return true;
  }


  if (
    alarma.repeticion ==
    2
  ) {

    return

      (
        alarma.diasSemana &

        (
          1 <<
          diaSemana
        )
      )

      != 0;
  }


  if (
    alarma.repeticion ==
    3
  ) {

    return

      alarma.anio ==
      anio

      &&

      alarma.mes ==
      mes

      &&

      alarma.dia ==
      dia;
  }


  return false;
}

// =====================================================
// COMPROBAR ALARMAS
// =====================================================

void comprobarAlarmas() {

  if (
    !horaSincronizada
  ) {

    return;
  }


  if (
    alarmaSonandoIndice >= 0
  ) {

    return;
  }


  int64_t ahora =
    obtenerHoraLocal();


  int segundosDia =
    ahora %
    86400;


  if (
    segundosDia < 0
  ) {

    segundosDia +=
      86400;
  }


  int64_t numeroDia =

    (
      ahora -
      segundosDia
    )
    /
    86400;


  int horaActual =
    segundosDia /
    3600;


  int minutoActual =

    (
      segundosDia %
      3600
    )
    /
    60;


  int anioActual;

  unsigned mesActual;
  unsigned diaActual;


  fechaDesdeDias(

    numeroDia,

    anioActual,

    mesActual,

    diaActual
  );


  int diaSemana =

    (
      (
        numeroDia +
        4
      )
      %
      7
      +
      7
    )
    %
    7;


  for (
    int i = 0;
    i < cantidadAlarmas;
    i++
  ) {

    if (
      !alarmas[i].activa
    ) {

      continue;
    }


    if (

      alarmas[i].hora !=
      horaActual

      ||

      alarmas[i].minuto !=
      minutoActual

    ) {

      continue;
    }


    if (
      !correspondeFecha(

        alarmas[i],

        anioActual,

        mesActual,

        diaActual,

        diaSemana
      )
    ) {

      continue;
    }


    if (
      ultimoDiaActivado[i] ==
      numeroDia
    ) {

      continue;
    }


    ultimoDiaActivado[i] =
      numeroDia;


    iniciarAlarma(
      i
    );


    if (

      alarmas[i].repeticion ==
      0

      ||

      alarmas[i].repeticion ==
      3

    ) {

      alarmas[i].activa =
        false;


      guardarAlarmasEnMemoria();
    }


    break;
  }
}

// =====================================================
// REPROGRAMAR UNA VEZ
// =====================================================

void reprogramarUnaVez(
  int indice
) {

  if (
    !horaSincronizada
  ) {

    return;
  }


  if (
    alarmas[indice].repeticion !=
    0
  ) {

    return;
  }


  int64_t ahora =
    obtenerHoraLocal();


  int segundosDia =
    ahora %
    86400;


  if (
    segundosDia < 0
  ) {

    segundosDia +=
      86400;
  }


  int64_t diaActual =

    (
      ahora -
      segundosDia
    )
    /
    86400;


  int segundosAlarma =

    alarmas[indice].hora *
    3600

    +

    alarmas[indice].minuto *
    60;


  int64_t diaObjetivo =
    diaActual;


  if (
    segundosAlarma <=
    segundosDia
  ) {

    diaObjetivo++;
  }


  int anio;

  unsigned mes;
  unsigned dia;


  fechaDesdeDias(

    diaObjetivo,

    anio,

    mes,

    dia
  );


  alarmas[indice].anio =
    anio;


  alarmas[indice].mes =
    mes;


  alarmas[indice].dia =
    dia;
}

