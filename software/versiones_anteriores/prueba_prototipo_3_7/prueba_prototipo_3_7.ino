// =====================================================
// FECHAS
// =====================================================

void fechaDesdeDias(
  int64_t z,
  int& anio,
  unsigned& mes,
  unsigned& dia
) {

  z +=
    719468;


  const int64_t era =

    (
      z >= 0
        ? z
        : z - 146096
    )
    /
    146097;


  const unsigned doe =

    (unsigned)(
      z -
      era * 146097
    );


  const unsigned yoe =

    (
      doe -
      doe / 1460 +
      doe / 36524 -
      doe / 146096
    )
    /
    365;


  anio =

    (int)yoe +

    (int)(
      era * 400
    );


  const unsigned doy =

    doe -

    (
      365 * yoe +

      yoe / 4 -

      yoe / 100
    );


  const unsigned mp =

    (
      5 * doy +
      2
    )
    /
    153;


  dia =

    doy -

    (
      153 * mp +
      2
    )
    /
    5

    +
    1;


  mes =

    mp +

    (
      mp < 10
        ? 3
        : -9
    );


  anio +=
    mes <= 2;
}

// =====================================================
// MEMORIA
// =====================================================

void guardarAlarmasEnMemoria() {

  memoria.begin(
    "alarmas",
    false
  );


  memoria.putUChar(
    "cantidad",
    cantidadAlarmas
  );


  memoria.putBytes(
    "datos",
    alarmas,
    sizeof(alarmas)
  );


  memoria.end();
}


void cargarAlarmasDeMemoria() {

  bool migrarViejas =
    false;


  memoria.begin(
    "alarmas",
    true
  );


  cantidadAlarmas =
    memoria.getUChar(
      "cantidad",
      0
    );


  if (
    cantidadAlarmas >
    MAX_ALARMAS
  ) {

    cantidadAlarmas =
      0;
  }


  size_t tamano =
    memoria.getBytesLength(
      "datos"
    );


  if (
    tamano ==
    sizeof(alarmas)
  ) {

    memoria.getBytes(
      "datos",
      alarmas,
      sizeof(alarmas)
    );
  }

  else if (
    tamano ==
    sizeof(AlarmaVieja) *
    MAX_ALARMAS
  ) {

    AlarmaVieja viejas[
      MAX_ALARMAS
    ];


    memoria.getBytes(
      "datos",
      viejas,
      sizeof(viejas)
    );


    for (
      int i = 0;
      i < cantidadAlarmas;
      i++
    ) {

      alarmas[i].hora =
        viejas[i].hora;


      alarmas[i].minuto =
        viejas[i].minuto;


      alarmas[i].tono =
        viejas[i].tono;


      alarmas[i].modo =
        viejas[i].modo;


      alarmas[i].activa =
        viejas[i].activa;


      alarmas[i].repeticion =
        1;


      alarmas[i].diasSemana =
        0;


      alarmas[i].anio =
        0;


      alarmas[i].mes =
        0;


      alarmas[i].dia =
        0;
    }


    migrarViejas =
      true;
  }

  else {

    cantidadAlarmas =
      0;
  }


  memoria.end();


  for (
    int i = 0;
    i < MAX_ALARMAS;
    i++
  ) {

    ultimoDiaActivado[i] =
      -1;
  }


  if (
    migrarViejas
  ) {

    guardarAlarmasEnMemoria();
  }
}

// =====================================================
// HORA
// =====================================================

int64_t obtenerHoraLocal() {

  if (
    !horaSincronizada
  ) {

    return 0;
  }


  uint32_t transcurrido =

    millis() -
    millisSincronizacion;


  return

    horaLocalSincronizada +

    (
      transcurrido /
      1000
    );
}

// =====================================================
// JSON
// =====================================================

String crearJsonAlarmas() {

  String json =
    "[";


  for (
    int i = 0;
    i < cantidadAlarmas;
    i++
  ) {

    if (
      i > 0
    ) {

      json += ",";
    }


    json += "{";


    json += "\"hour\":";
    json += alarmas[i].hora;


    json += ",\"minute\":";
    json += alarmas[i].minuto;


    json += ",\"tone\":";
    json += alarmas[i].tono;


    json += ",\"mode\":";
    json += alarmas[i].modo;


    json += ",\"repeat\":";
    json += alarmas[i].repeticion;


    json += ",\"days\":";
    json += alarmas[i].diasSemana;


    json += ",\"year\":";
    json += alarmas[i].anio;


    json += ",\"month\":";
    json += alarmas[i].mes;


    json += ",\"day\":";
    json += alarmas[i].dia;


    json += ",\"active\":";

    json +=

      alarmas[i].activa

        ? "true"

        : "false";


    json += "}";
  }


  json += "]";


  return json;
}

