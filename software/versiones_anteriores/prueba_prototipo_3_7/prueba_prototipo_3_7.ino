// =====================================================
// NOMBRES
// =====================================================

String nombreTono(uint8_t tono) {

  switch (tono) {

    case 0:
      return "Homecoming";

    case 1:
      return "Quantum Bell";

    case 2:
      return "Space Bell";

    case 3:
      return "Megalovania";

    case 4:
      return "Never Gonna Give You Up";

    case 5:
      return "Take On Me";
  }

  return "Tono";
}

String nombreModo(uint8_t modo) {

  switch (modo) {

    case 0:
      return "Sonido";

    case 1:
      return "Vibración";

    case 2:
      return "Sonido + vibración";
  }

  return "Modo";
}

