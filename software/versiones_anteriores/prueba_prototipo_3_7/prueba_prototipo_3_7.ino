  "      document.getElementById(\n"
  "        \"repeticion\"\n"
  "      ).value\n"
  "    );\n"
  "\n"
  "\n"
  "  const dias =\n"
  "    obtenerMascaraDias();\n"
  "\n"
  "\n"
  "  const fechaTexto =\n"
  "    document.getElementById(\n"
  "      \"fechaEspecifica\"\n"
  "    ).value;\n"
  "\n"
  "\n"
  "  if (\n"
  "    repeticion === 2 &&\n"
  "    dias === 0\n"
  "  ) {\n"
  "\n"
  "    mostrarAviso(\n"
  "      \"Elige al menos un día\"\n"
  "    );\n"
  "\n"
  "    return;\n"
  "  }\n"
  "\n"
  "\n"
  "  const proxima =\n"
  "    calcularProximaFecha(\n"
  "\n"
  "      hora,\n"
  "\n"
  "      minuto,\n"
  "\n"
  "      repeticion,\n"
  "\n"
  "      dias,\n"
  "\n"
  "      fechaTexto\n"
  "    );\n"
  "\n"
  "\n"
  "  if (\n"
  "    !proxima\n"
  "  ) {\n"
  "\n"
  "    mostrarAviso(\n"
  "      \"Esa fecha u hora ya pasó\"\n"
  "    );\n"
  "\n"
  "    return;\n"
  "  }\n"
  "\n"
  "\n"
  "  let anio = 0;\n"
  "  let mes = 0;\n"
  "  let dia = 0;\n"
  "\n"
  "\n"
  "  if (\n"
  "    repeticion === 0 ||\n"
  "    repeticion === 3\n"
  "  ) {\n"
  "\n"
  "    anio =\n"
  "      proxima.getFullYear();\n"
  "\n"
  "\n"
  "    mes =\n"
  "      proxima.getMonth() + 1;\n"
  "\n"
  "\n"
  "    dia =\n"
  "      proxima.getDate();\n"
  "  }\n"
