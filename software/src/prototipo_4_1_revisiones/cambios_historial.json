{"format":"line-splice-v1","base":"software/src/alarma_final/alarma_final.ino","base_blob_sha":"1e2b935e81a68307174c2be4f25e73e6280a99a4","target_sha256":"208315bc108a2254ccd5680eb2847651c3794a65b03475199f48c6160c0e1201","expected_final_lines":41908,"edits":[{"start":0,"delete":1,"insert":["// PRUEBA PROTOTIPO 4_1 REVISIONES"]},{"start":8,"delete":0,"insert":["#include <freertos/queue.h>","#include <esp_timer.h>","#include <stddef.h>"]},{"start":19,"delete":0,"insert":["// Declaraciones explicitas para el preprocesador de Arduino IDE.","struct Alarma;","struct HistRegistro;","struct HistEvento;","uint32_t histChecksum(const HistRegistro& registro);","void histProcesarEvento(const HistEvento& evento);","void histNotificarInicio(const Alarma& alarma);",""]},{"start":100,"delete":0,"insert":["portMUX_TYPE relojMux = portMUX_INITIALIZER_UNLOCKED;"]},{"start":673,"delete":0,"insert":["  R\"HISTORIA(.historial-panel { background: white; border-radius: 18px; margin: 0 0 18px; padding: 16px; }",".historial-panel summary { cursor: pointer; font-weight: bold; font-size: 18px; }",".historial-contenido { font-size: 14px; line-height: 1.45; }",".historial-contenido p { margin: 12px 0; }",".historial-error { background: #fff0e7; color: #783000; padding: 10px; border-radius: 8px; }",".historial-tabla-contenedor { width: 100%; overflow-x: auto; margin: 14px 0; }",".historial-tabla { border-collapse: collapse; font-size: 13px; min-width: 970px; width: 100%; }",".historial-tabla th, .historial-tabla td { padding: 9px 8px; border-bottom: 1px solid #ddd; text-align: left; vertical-align: top; }",".historial-tabla th { background: #f3f3f7; }",".historial-barra { display: flex; gap: 8px; align-items: center; margin: 7px 0; }",".historial-barra-nombre { width: 130px; flex: 0 0 130px; }",".historial-barra-fondo { flex: 1; height: 13px; background: #e9ebef; border-radius: 7px; overflow: hidden; }",".historial-barra-valor { height: 100%; background: #007aff; }",".historial-barra-numero { min-width: 22px; text-align: right; }",".historial-boton { border: none; border-radius: 10px; padding: 11px 14px; background: #007aff; color: white; font-size: 14px; }",".historial-boton:disabled { opacity: 0.5; }",")HISTORIA\""]},{"start":723,"delete":0,"insert":["  R\"HISTORIA(<details id=\"historialPanel\" class=\"historial-panel\">","  <summary>Historial de alarmas</summary>","  <div class=\"historial-contenido\">","    <p id=\"historialEstado\" aria-live=\"polite\">Cargando historial...</p>","    <p id=\"historialError\" class=\"historial-error\" hidden></p>","    <p id=\"historialTotal\"></p>","    <div id=\"historialGrafico\" aria-label=\"Activaciones por modo\"></div>","    <p id=\"historialVacio\" hidden>Aún no hay activaciones registradas con esta versión.</p>","    <div id=\"historialTablaContenedor\" class=\"historial-tabla-contenedor\" hidden>","      <table class=\"historial-tabla\">","        <thead><tr>","          <th>ID</th><th>Activación</th><th>Hora programada</th><th>Melodía</th>","          <th>Modo</th><th>Detención</th><th>Tiempo hasta detener</th><th>Origen</th><th>Estado</th>","        </tr></thead>","        <tbody id=\"historialFilas\"></tbody>","      </table>","    </div>","    <button id=\"historialCSV\" class=\"historial-boton\" type=\"button\" disabled>Descargar CSV</button>","  </div>","</details>",")HISTORIA\""]},{"start":2338,"delete":0,"insert":["  R\"HISTORIA(// Historial local: solo consulta eventos reales generados por el ESP32.","const historialPanel = document.getElementById('historialPanel');","let historialDatos = null;","let historialCargando = false;","","function historialDos(n) { return String(n).padStart(2, '0'); }","function historialFecha(segundos) {","  if (segundos === null) return 'Sin sincronizar';","  // El ESP32 guarda la hora local que recibio del telefono como fecha sin zona.","  const f = new Date(segundos * 1000);","  if (Number.isNaN(f.getTime())) return 'Fecha no disponible';","  return historialDos(f.getUTCDate()) + '/' + historialDos(f.getUTCMonth()+1) + '/' +","    f.getUTCFullYear() + ' ' + historialDos(f.getUTCHours()) + ':' +","    historialDos(f.getUTCMinutes()) + ':' + historialDos(f.getUTCSeconds());","}","function historialDuracion(ms) {","  if (ms === null) return 'Sin detención registrada';","  const s = Math.floor(ms / 1000), h = Math.floor(s / 3600), m = Math.floor((s % 3600) / 60);","  return (h ? h + ' h ' : '') + (m ? m + ' min ' : '') + (s % 60) + ' s';","}","function historialNombreModo(m) {","  return nombresModos[m] === undefined ? 'Modo no reconocido' : nombresModos[m];","}","function historialNombreTono(t) {","  return nombresTonos[t] === undefined ? 'Melodía no reconocida' : nombresTonos[t];","}","function historialOrigen(r) {","  if (!r.cerrado) return 'Sin detención registrada';","  if (r.origen === 1) return 'Botón físico';","  if (r.origen === 2) return 'Página web';","  return 'Origen no registrado';","}","function historialEstadoRegistro(r, datos) {","  let estado = r.cerrado ? 'Detenida' :","    (datos.sonando && datos.activo === r.id ? 'Activa' : 'Incompleta: sin detención registrada');","  if (!r.guardado) estado += ' · sin confirmar en memoria';","  return estado;","}","function historialValores(r, datos) {","  return [String(r.id), historialFecha(r.inicio), historialDos(r.hora) + ':' + historialDos(r.minuto),","    historialNombreTono(r.tono), historialNombreModo(r.modo),","    r.cerrado ? historialFecha(r.fin) : 'Sin detención registrada',","    historialDuracion(r.duracion_ms), historialOrigen(r), historialEstadoRegistro(r, datos)];","}","function historialMostrar(datos) {","  historialDatos = datos;","  const registros = datos.registros;","  document.getElementById('historialEstado').textContent = datos.sonando ? 'Alarma activa' : 'No hay una alarma activa';","  const aviso = document.getElementById('historialError');","  aviso.hidden = !datos.error;","  aviso.textContent = datos.error ? 'Hubo un problema al leer o guardar el historial. Algunos registros podrían no conservarse; revisa el monitor serie.' : '';","  document.getElementById('historialTotal').textContent = 'Activaciones en el historial: ' + registros.length + ' de ' + datos.maximo + ' como máximo.';","  document.getElementById('historialVacio').hidden = registros.length !== 0;","  document.getElementById('historialTablaContenedor').hidden = registros.length === 0;","  document.getElementById('historialCSV').disabled = registros.length === 0;","  const filas = document.getElementById('historialFilas');","  filas.replaceChildren();","  registros.forEach(r => {","    const tr = document.createElement('tr');","    historialValores(r, datos).forEach(v => { const td = document.createElement('td'); td.textContent = v; tr.appendChild(td); });","    filas.appendChild(tr);","  });","  const grafico = document.getElementById('historialGrafico');","  grafico.replaceChildren();","  [0, 1, 2].forEach(m => {","    const n = registros.filter(r => r.modo === m).length;","    const fila = document.createElement('div'); fila.className = 'historial-barra';","    const nombre = document.createElement('span'); nombre.className = 'historial-barra-nombre'; nombre.textContent = historialNombreModo(m);","    const fondo = document.createElement('div'); fondo.className = 'historial-barra-fondo';","    const barra = document.createElement('div'); barra.className = 'historial-barra-valor';","    barra.style.width = (registros.length ? n * 100 / registros.length : 0) + '%';","    const numero = document.createElement('span'); numero.className = 'historial-barra-numero'; numero.textContent = String(n);","    fondo.appendChild(barra); fila.append(nombre, fondo, numero); grafico.appendChild(fila);","  });","}","async function cargarHistorial() {","  if (historialCargando) return;","  historialCargando = true;","  try {","    const respuesta = await fetch('/api/historial', {cache:'no-store'});","    if (!respuesta.ok) throw new Error('No disponible');","    const datos = await respuesta.json();","    if (!Array.isArray(datos.registros)) throw new Error('Formato inválido');","    historialMostrar(datos);","  } catch (e) {","    const aviso = document.getElementById('historialError');","    aviso.hidden = false;","    aviso.textContent = 'No se pudo consultar el historial. Vuelve a abrir esta sección para intentarlo otra vez.';","  } finally { historialCargando = false; }","}","function descargarHistorial() {","  if (!historialDatos || !historialDatos.registros.length) return;","  const encabezado = ['ID','Activación','Hora programada','Melodía','Modo','Detención','Tiempo hasta detener la alarma','Origen','Estado'];","  const escapar = v => '\"' + String(v).replace(/\"/g, '\"\"') + '\"';","  const filas = [encabezado].concat(historialDatos.registros.map(r => historialValores(r, historialDatos)));","  const csv = '\\ufeff' + filas.map(f => f.map(escapar).join(',')).join('\\r\\n');","  const enlace = document.createElement('a');","  enlace.href = URL.createObjectURL(new Blob([csv], {type:'text/csv;charset=utf-8'}));","  enlace.download = 'historial_alarmas.csv';","  document.body.appendChild(enlace); enlace.click(); enlace.remove();","  setTimeout(() => URL.revokeObjectURL(enlace.href), 2000);","}","historialPanel.addEventListener('toggle', () => { if (historialPanel.open) cargarHistorial(); });","document.getElementById('historialCSV').addEventListener('click', descargarHistorial);","setInterval(() => { if (historialPanel.open) cargarHistorial(); }, 4000);",")HISTORIA\""]},{"start":2633,"delete":24,"insert":["  // El servidor asincrono puede sincronizar mientras otra tarea lee la hora.","  portENTER_CRITICAL(&relojMux);","  const bool sincronizada = horaSincronizada;","  const int64_t baseLocal = horaLocalSincronizada;","  const uint32_t baseMillis = millisSincronizacion;","  portEXIT_CRITICAL(&relojMux);","  if (!sincronizada) return 0;","  const uint32_t transcurrido = (uint32_t)millis() - baseMillis;","  return baseLocal + transcurrido / 1000U;","}","","// Historial independiente de las preferencias de alarmas.","// Cada ranura se escribe solamente al iniciar o detener una activacion.","// La cola separa el sonido y el rele de las escrituras a memoria flash.","static const uint8_t HIST_MAX = 32;","static const uint8_t HIST_ORIGEN_DESCONOCIDO = 0;","static const uint8_t HIST_ORIGEN_BOTON = 1;","static const uint8_t HIST_ORIGEN_WEB = 2;","static const uint32_t HIST_MAGIC = 0x48495331UL; // formato H I S 1","","struct HistRegistro {","  uint32_t magic;","  uint32_t id;","  int64_t inicioLocal;","  int64_t finLocal;","  uint64_t duracionMs;","  uint8_t hora;","  uint8_t minuto;","  uint8_t tono;","  uint8_t modo;","  uint8_t origen;","  uint8_t cerrado;","  uint16_t reservado;","  uint32_t checksum;","};","static_assert(sizeof(HistRegistro) <= 64, \"Registro demasiado grande\");","","struct HistEvento {","  uint32_t id;","  int64_t fechaLocal;","  uint64_t duracionMs;","  uint8_t tipo; // 1 inicio, 2 detencion","  uint8_t hora, minuto, tono, modo, origen;","};","","HistRegistro histRegistros[HIST_MAX] = {};","bool histPersistido[HIST_MAX] = {};","SemaphoreHandle_t histMutex = nullptr;","QueueHandle_t histCola = nullptr;","bool histEscrituraPermitida = true;","uint32_t histSiguienteId = 1;","uint32_t histIdEnSalida = 0; // protegido por candadoSalidas","uint64_t histInicioMs = 0;  // protegido por candadoSalidas","portMUX_TYPE histEstadoMux = portMUX_INITIALIZER_UNLOCKED;","bool histError = false;  // protegido por histEstadoMux","uint32_t histIdActivo = 0; // protegido por histEstadoMux","","void histMarcarError() {","  portENTER_CRITICAL(&histEstadoMux);","  histError = true;","  portEXIT_CRITICAL(&histEstadoMux);","}","","void histFijarActivo(uint32_t id) {","  portENTER_CRITICAL(&histEstadoMux);","  histIdActivo = id;","  portEXIT_CRITICAL(&histEstadoMux);","}","","void histEstado(uint32_t* activo, bool* error) {","  portENTER_CRITICAL(&histEstadoMux);","  *activo = histIdActivo;","  *error = histError;","  portEXIT_CRITICAL(&histEstadoMux);","}","","uint32_t histChecksum(const HistRegistro& registro) {","  const uint8_t* p = reinterpret_cast<const uint8_t*>(&registro);","  uint32_t h = 2166136261UL;","  for (size_t i = 0; i < offsetof(HistRegistro, checksum); ++i) {","    h ^= p[i];","    h *= 16777619UL;","  }","  return h;","}","","void histClave(uint8_t ranura, char* clave, size_t tamano) {","  snprintf(clave, tamano, \"r%02u\", (unsigned)ranura);","}","","// Se llama una sola vez durante setup, antes de abrir el servidor.","void histCargar() {","  Preferences preferenciasHist;","  if (!preferenciasHist.begin(\"hist_alarma\", false)) {","    histEscrituraPermitida = false;","    histMarcarError();","    Serial.println(\"Historial: no se pudo abrir NVS\");","    return;","  }","  uint32_t maximo = 0;","  for (uint8_t i = 0; i < HIST_MAX; ++i) {","    char clave[8];","    histClave(i, clave, sizeof(clave));","    if (!preferenciasHist.isKey(clave)) continue;","    HistRegistro r = {};","    const size_t largo = preferenciasHist.getBytesLength(clave);","    if (largo != sizeof(r) ||","        preferenciasHist.getBytes(clave, &r, sizeof(r)) != sizeof(r) ||","        r.magic != HIST_MAGIC || r.id == 0 || r.hora > 23 || r.minuto > 59 ||","        r.cerrado > 1 || r.origen > HIST_ORIGEN_WEB ||","        r.checksum != histChecksum(r)) {","      // No sobrescribir un historial que no se pudo leer correctamente.","      histEscrituraPermitida = false;","      histMarcarError();","      Serial.println(\"Historial: registro ilegible; escritura deshabilitada\");","      continue;","    }","    for (uint8_t j = 0; j < i; ++j) {","      if (histRegistros[j].id == r.id) {","        histEscrituraPermitida = false;","        histMarcarError();","      }","    }","    histRegistros[i] = r;","    histPersistido[i] = true;","    if (r.id > maximo) maximo = r.id;","  }","  preferenciasHist.end();","  // No reutilizar identificadores si se llegara al limite del entero.","  if (maximo == UINT32_MAX) {","    histSiguienteId = 0;","    histMarcarError();","  } else {","    histSiguienteId = maximo + 1;","  }","}","","// Solo se ejecuta en la tarea del historial, no en el bucle de la alarma.","bool histGuardarRanura(uint8_t ranura) {","  if (!histEscrituraPermitida) return false;","  Preferences preferenciasHist;","  if (!preferenciasHist.begin(\"hist_alarma\", false)) return false;","  char clave[8];","  histClave(ranura, clave, sizeof(clave));","  HistRegistro comprobacion = {};","  const bool ok = preferenciasHist.putBytes(clave, &histRegistros[ranura],","                                            sizeof(HistRegistro)) == sizeof(HistRegistro) &&","                  preferenciasHist.getBytesLength(clave) == sizeof(HistRegistro) &&","                  preferenciasHist.getBytes(clave, &comprobacion, sizeof(comprobacion)) == sizeof(comprobacion) &&","                  memcmp(&comprobacion, &histRegistros[ranura], sizeof(comprobacion)) == 0;","  preferenciasHist.end();","  return ok;","}","","void histProcesarEvento(const HistEvento& evento) {","  if (xSemaphoreTake(histMutex, portMAX_DELAY) != pdTRUE) {","    histMarcarError();","    return;","  }","  int ranura = -1;","  if (evento.tipo == 1) {","    uint32_t masAntiguo = UINT32_MAX;","    for (uint8_t i = 0; i < HIST_MAX; ++i) {","      if (histRegistros[i].id == 0) { ranura = i; break; }","      if (histRegistros[i].id < masAntiguo) {","        masAntiguo = histRegistros[i].id;","        ranura = i;","      }","    }","    if (ranura >= 0) {","      HistRegistro r = {};","      r.magic = HIST_MAGIC;","      r.id = evento.id;","      r.inicioLocal = evento.fechaLocal;","      r.hora = evento.hora;","      r.minuto = evento.minuto;","      r.tono = evento.tono;","      r.modo = evento.modo;","      r.checksum = histChecksum(r);","      histRegistros[ranura] = r;","    }","  } else if (evento.tipo == 2) {","    for (uint8_t i = 0; i < HIST_MAX; ++i) {","      if (histRegistros[i].id == evento.id) { ranura = i; break; }","    }","    if (ranura >= 0 && !histRegistros[ranura].cerrado) {","      HistRegistro& r = histRegistros[ranura];","      r.finLocal = evento.fechaLocal;","      r.duracionMs = evento.duracionMs;","      r.origen = evento.origen;","      r.cerrado = 1;","      r.checksum = histChecksum(r);","    } else {","      ranura = -1; // sin inicio o detencion duplicada","    }","  }","  if (ranura >= 0) {","    histPersistido[ranura] = histGuardarRanura((uint8_t)ranura);","    if (!histPersistido[ranura]) {","      histMarcarError();","      Serial.println(\"Historial: no se pudo confirmar la escritura\");","    }","  } else {","    histMarcarError();","  }","  xSemaphoreGive(histMutex);","}","","void histTarea(void*) {","  HistEvento evento;","  for (;;) {","    if (xQueueReceive(histCola, &evento, portMAX_DELAY) == pdTRUE)","      histProcesarEvento(evento);","  }","}","","void histIniciar() {","  histMutex = xSemaphoreCreateMutex();","  if (histMutex == nullptr) { histMarcarError(); return; }","  histCargar();","  histCola = xQueueCreate(16, sizeof(HistEvento));","  if (histCola == nullptr) { histMarcarError(); return; }","  if (xTaskCreatePinnedToCore(histTarea, \"historial\", 4096, nullptr, 1, nullptr, 0) != pdPASS) {","    vQueueDelete(histCola);","    histCola = nullptr;","    histMarcarError();","  }","}","","// Las dos funciones siguientes se llaman mientras candadoSalidas esta tomado.","// Solo encolan datos: no esperan a que se escriba en flash.","void histNotificarInicio(const Alarma& alarma) {","  if (histSiguienteId == 0) { histMarcarError(); return; }","  HistEvento e = {};","  e.id = histSiguienteId++;","  if (histSiguienteId == 0) histMarcarError();","  e.tipo = 1;","  e.hora = alarma.hora; e.minuto = alarma.minuto;","  e.tono = alarma.tono; e.modo = alarma.modo;","  e.fechaLocal = obtenerHoraLocal();","  histInicioMs = (uint64_t)esp_timer_get_time() / 1000ULL;","  histIdEnSalida = e.id;","  histFijarActivo(e.id);","  if (histCola == nullptr || xQueueSend(histCola, &e, 0) != pdTRUE) histMarcarError();","}","","void histNotificarFin(uint8_t origen) {","  if (histIdEnSalida == 0) return;","  HistEvento e = {};","  e.id = histIdEnSalida;","  e.tipo = 2;","  e.origen = origen <= HIST_ORIGEN_WEB ? origen : HIST_ORIGEN_DESCONOCIDO;","  e.fechaLocal = obtenerHoraLocal();","  const uint64_t ahoraMs = (uint64_t)esp_timer_get_time() / 1000ULL;","  e.duracionMs = ahoraMs >= histInicioMs ? ahoraMs - histInicioMs : 0;","  histIdEnSalida = 0;","  histFijarActivo(0);","  if (histCola == nullptr || xQueueSend(histCola, &e, 0) != pdTRUE) histMarcarError();","}","","void histEnviarJson(AsyncWebServerRequest* request) {","  if (histMutex == nullptr || xSemaphoreTake(histMutex, pdMS_TO_TICKS(40)) != pdTRUE) {","    request->send(503, \"application/json\", \"{\\\"error\\\":true}\");","    return;","  }","  // Copia breve para no mantener el candado durante el envio por Wi-Fi.","  HistRegistro copia[HIST_MAX];","  bool guardado[HIST_MAX];","  memcpy(copia, histRegistros, sizeof(copia));","  memcpy(guardado, histPersistido, sizeof(guardado));","  xSemaphoreGive(histMutex);","  uint32_t activo = 0;","  bool error = false;","  histEstado(&activo, &error);","","  AsyncResponseStream* respuesta = request->beginResponseStream(\"application/json; charset=utf-8\");","  if (respuesta == nullptr) { request->send(503, \"text/plain\", \"Sin memoria\"); return; }","  respuesta->addHeader(\"Cache-Control\", \"no-store\");","  respuesta->printf(\"{\\\"maximo\\\":%u,\\\"error\\\":%s,\\\"sonando\\\":%s,\\\"activo\\\":%lu,\\\"registros\\\":[\",","                    (unsigned)HIST_MAX, error ? \"true\" : \"false\",","                    musicaActiva ? \"true\" : \"false\", (unsigned long)activo);","  // Orden descendente por ID; los huecos no se muestran como registros.","  uint32_t limite = UINT32_MAX;","  bool primero = true;","  for (uint8_t n = 0; n < HIST_MAX; ++n) {","    int elegido = -1;","    uint32_t mejor = 0;","    for (uint8_t i = 0; i < HIST_MAX; ++i) {","      if (copia[i].id > mejor && (primero || copia[i].id < limite)) {","        elegido = i; mejor = copia[i].id;","      }","    }","    if (elegido < 0) break;","    const HistRegistro& r = copia[elegido];","    if (!primero) respuesta->print(',');","    primero = false;","    limite = r.id;","    respuesta->printf(\"{\\\"id\\\":%lu,\\\"hora\\\":%u,\\\"minuto\\\":%u,\\\"tono\\\":%u,\\\"modo\\\":%u,\\\"cerrado\\\":%s,\\\"origen\\\":%u,\\\"guardado\\\":%s,\\\"inicio\\\":\",","      (unsigned long)r.id, (unsigned)r.hora, (unsigned)r.minuto,","      (unsigned)r.tono, (unsigned)r.modo, r.cerrado ? \"true\" : \"false\",","      (unsigned)r.origen, guardado[elegido] ? \"true\" : \"false\");","    if (r.inicioLocal != 0) respuesta->printf(\"%lld\", (long long)r.inicioLocal);","    else respuesta->print(\"null\");","    respuesta->print(\",\\\"fin\\\":\");","    if (r.cerrado && r.finLocal != 0) respuesta->printf(\"%lld\", (long long)r.finLocal);","    else respuesta->print(\"null\");","    respuesta->print(\",\\\"duracion_ms\\\":\");","    if (r.cerrado) respuesta->printf(\"%llu\", (unsigned long long)r.duracionMs);","    else respuesta->print(\"null\");","    respuesta->print('}');","  }","  respuesta->print(\"]}\");","  request->send(respuesta);","}",""]},{"start":2883,"delete":1,"insert":["void apagarSalidas(uint8_t origenHistorial) {"]},{"start":2892,"delete":0,"insert":["  const bool estabaActivaParaHistorial = musicaActiva;"]},{"start":2899,"delete":0,"insert":["  if (estabaActivaParaHistorial) histNotificarFin(origenHistorial);"]},{"start":2970,"delete":5,"insert":["void detenerAlarmaActual(uint8_t origenHistorial) {","","  ++generacionAnimacionOLED;","","  apagarSalidas(origenHistorial);"]},{"start":3025,"delete":1,"insert":["      detenerAlarmaActual(HIST_ORIGEN_BOTON);"]},{"start":3077,"delete":0,"insert":["  histNotificarInicio(alarmas[indice]);"]},{"start":3146,"delete":1,"insert":["    detenerAlarmaActual(HIST_ORIGEN_DESCONOCIDO);"]},{"start":3168,"delete":1,"insert":["      detenerAlarmaActual(HIST_ORIGEN_DESCONOCIDO);"]},{"start":3691,"delete":22,"insert":["      const int64_t nuevaHoraLocal = epochMs / 1000 - (int64_t)offsetMinutos * 60;","      const uint32_t nuevaBaseMillis = (uint32_t)millis();","      portENTER_CRITICAL(&relojMux);","      horaLocalSincronizada = nuevaHoraLocal;","      millisSincronizacion = nuevaBaseMillis;","      horaSincronizada = true;","      portEXIT_CRITICAL(&relojMux);"]},{"start":3928,"delete":1,"insert":["        detenerAlarmaActual(HIST_ORIGEN_DESCONOCIDO);"]},{"start":4094,"delete":1,"insert":["        detenerAlarmaActual(HIST_ORIGEN_DESCONOCIDO);"]},{"start":4170,"delete":1,"insert":["        detenerAlarmaActual(HIST_ORIGEN_DESCONOCIDO);"]},{"start":4233,"delete":11,"insert":["      detenerAlarmaActual(HIST_ORIGEN_WEB);","","","      request->send(","        200,","        \"text/plain\",","        \"OK\"","      );","    }","  );","","","  // CONSULTA DEL HISTORIAL: lectura sin modificar registros.","  server.on(\"/api/historial\", HTTP_GET, [](AsyncWebServerRequest* request) {","    histEnviarJson(request);","  });"]},{"start":41359,"delete":0,"insert":["  histIniciar();"]}]}